@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="login-grid">

    <img src="/recursos/Img/Inicio de sesión.png" class="login-img" alt="Mascota PawPort" />
    <div class="login-form">

        <div class="form-card" style="width:100%">

            <h2>¡Hola de nuevo! 👋</h2>
            <p class="muted">Ingresa a tu cuenta de la red internacional PawPort.</p>

            <form asp-controller="Login" asp-action="Index" method="post">
                <label>Correo electrónico</label>
                <input type="email" name="correo" class="form-control" placeholder="ejemplo@pawport.com" required />
                <label>Contraseña</label>
                <input type="password" name="clave" class="form-control" placeholder="••••••••" required />
                <br />
                <button type="submit" class="btn-paw" style="width:100%">Iniciar sesión</button>
            </form>

            @if (ViewBag.Error != null)
            {
                <p class="msg-error" style="margin-top:1rem">@ViewBag.Error</p>
            }

            <div class="card-paw pad" style="margin-top:1.2rem;background:var(--soft);font-size:.9rem">
                <strong>Cuentas de demostración por rol (Clave: 1234):</strong>
                <ul style="margin:.4rem 0 0;padding-left:1.2rem">
                    <li><b>Propietario:</b> propietario@pawport.com</li>
                    <li><b>Veterinario:</b> veterinario@pawport.com</li>
                    <li><b>Admin Sucursal:</b> sucursal@pawport.com</li>
                    <li><b>Admin Central:</b> admin@pawport.com</li>
                </ul>
            </div>

            <p class="muted" style="margin-top:1rem">
                ¿No tienes cuenta? <a asp-controller="Registro" asp-action="Index">Regístrate aquí</a>
            </p>

        </div>

    </div>

</div>