<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - PawPort Clínica</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/pawport.css" />
    <link rel="shortcut icon" href="~/favicon.ico" type="image/x-icon" />
</head>
<body>
    <header class="nav-paw">
        <div class="container nav-inner">
            <a class="brand" asp-controller="Dashboard" asp-action="Index">🐾 PawPort Clínica</a>
            <nav class="menu">
                <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <a asp-controller="GestionCitas" asp-action="Index">Citas</a>
                <a asp-controller="Home" asp-action="Index" class="btn-line">Cerrar sesión</a>
            </nav>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="footer-paw">
        <div class="container footer-bottom" style="border:0;margin:0">
            © @DateTime.Now.Year PawPort - Panel de la clínica
        </div>
    </footer>
</body>
</html>