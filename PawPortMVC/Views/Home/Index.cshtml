@using PawPortMVC.Models
@using PawPortMVC.DAL
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Inicio";
    List<Clinica> clinicas = ViewBag.Clinicas;
}
<section class="hero">
    <div class="container hero-grid">
        <div>
            <h1>Cuidamos a quienes más amas 🐾</h1>
            <p class="muted">PawPort, de A2D2, es una red internacional de clínicas veterinarias. Registra a tu mascota, consulta su historial médico y agenda citas desde un solo lugar.</p>
            <a asp-controller="Registro" asp-action="Index" class="btn-paw">Registrarme</a>
            <a asp-controller="ExplorarClinicas" asp-action="Index" class="btn-line">Explorar clínicas</a>
        </div>
        <img src="~/recursos/Img/veterinaria-perro.png" class="hero-img" alt="Veterinaria con mascota" />
    </div>
</section>

<section class="section">
    <div class="container">
        <h2>Todo lo que necesitas en un solo lugar</h2>
        <p class="sub">Servicios pensados para dueños, veterinarios y administradores.</p>
        <div class="grid">
            <div class="card-paw pad"><div class="icono"></div><h3>Registro de mascotas</h3><p class="muted">Crea el perfil de cada mascota con su información básica.</p></div>
            <div class="card-paw pad"><div class="icono"></div><h3>Citas en línea</h3><p class="muted">Solicita, reprograma o cancela citas sin llamadas.</p></div>
            <div class="card-paw pad"><div class="icono"></div><h3>Expediente médico</h3><p class="muted">Diagnósticos, tratamientos y vacunas siempre disponibles.</p></div>
            <div class="card-paw pad"><div class="icono"></div><h3>Múltiples clínicas</h3><p class="muted">Tu historial te acompaña en cualquier sucursal de la red.</p></div>
            <div class="card-paw pad"><div class="icono"></div><h3>Recordatorios</h3><p class="muted">Avisos de citas y vacunas pendientes.</p></div>
            <div class="card-paw pad"><div class="icono"></div><h3>Facturación</h3><p class="muted">Cobros claros de consultas, tratamientos y medicamentos.</p></div>
        </div>
    </div>
</section>

<section class="section" style="background:#fff">
    <div class="container">
        <h2>Nuestra red de clínicas</h2>
        <p class="sub">Atención profesional en distintas ciudades.</p>
        <div class="grid">
            @foreach (Clinica c in clinicas)
            {
                <article class="card-paw">
                    <img class="card-img" src="@c.Imagen" alt="@c.Nombre" />
                    <div class="card-body-paw">
                        <h3>@c.Nombre</h3>
                        <p class="muted">📍 @c.Ciudad</p>
                        <a class="btn-line" asp-controller="AgendarCita" asp-action="Index" asp-route-clinica="@c.Nombre">Ver clínica</a>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="stats">
    <div class="container grid">
        <div class="stat"><b>+500</b>Clínicas asociadas</div>
        <div class="stat"><b>+10,000</b>Mascotas registradas</div>
        <div class="stat"><b>+50</b>Ciudades</div>
        <div class="stat"><b>+200</b>Veterinarios</div>
    </div>
</section>

<section class="section">
    <div class="container">
        <h2>Contáctanos</h2>
        <p class="sub">contacto@pawport.com · +503 2222 0000 · San Salvador, El Salvador</p>
        <div class="form-card">
            <form asp-controller="Home" asp-action="Contacto" method="post">
                <label>Nombre</label>
                <input type="text" name="nombre" class="form-control" />
                <label>Correo</label>
                <input type="email" name="correo" class="form-control" />
                <label>Mensaje</label>
                <textarea name="mensaje" class="form-control" rows="4"></textarea>
                <br />
                <button type="submit" class="btn-paw">Enviar mensaje</button>
            </form>
            @if (ViewBag.Mensaje != null)
            {
                <p class="@ViewBag.MensajeClase">@ViewBag.Mensaje</p>
            }
        </div>
    </div>
</section>