@{
    ViewData["Title"] = "Portafolio";
}
<section class="banner">
    <div class="container">
        <h1>Nuestro portafolio</h1>
        <p>Así se verá PawPort: prototipo del diseño final creado en Figma.</p>
    </div>
</section>
<section class="section">
    <div class="container" style="text-align:center">
        <h2>Prototipo en Figma</h2>
        <p class="sub">Explora todas las pantallas: landing, login, registros, dashboards, citas y mascotas.</p>
        <a href="https://www.figma.com/TU-ENLACE-AQUI" target="_blank" class="btn-paw btn-big">Ver prototipo en Figma ↗</a>
    </div>
    <div class="container galeria" style="margin-top:2.5rem">
        <div class="grid">
            <div><img src="/recursos/Img/pawport-landing-page.png" alt="Landing" /><p class="muted">Landing page</p></div>
            <div><img src="/recursos/Img/dashboard-usuario.png" alt="Dashboard" /><p class="muted">Dashboards y registros</p></div>
            <div><img src="/recursos/Img/Buenos_Aires.png" alt="Citas" /><p class="muted">Clínicas, citas y mascotas</p></div>
        </div>
    </div>
</section>