@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Portafolio";
    string? rolSesion = Context.Session.GetString("Rol");
    if (rolSesion == "Veterinario" || rolSesion == "AdministradorSucursal" || rolSesion == "AdminCentral")
    {
        Layout = "_AdminLayout";
    }
}
<section class="banner">
    <div class="container">
        <h1>Nuestro portafolio</h1>
        <p>Así se verá PawPort: prototipo del diseño final creado en Figma.</p>
    </div>
</section>
<section class="section">
    <div class="container" style="text-align:center">
        <h2>Prototipo en Figma</h2>
        <p class="sub">Explora todas las pantallas: landing, login, registros, dashboards, citas y mascotas.</p>
        <a href="https://www.figma.com/design/AZY7ISSEsifnJim3oF81tS/A2D2--Copy-?t=QybP9cV9oR6l8JUq-1" target="_blank" class="btn-paw btn-big">Ver prototipo en Figma</a>
    </div>
    <div class="container galeria" style="margin-top:2.5rem">
        <div class="grid">
            <div class="card-paw pad">
                <img src="/recursos/Img/pawport-landing-page.png" alt="Landing" style="height:220px;object-fit:cover;object-position:top" />
                <p class="muted" style="margin:.6rem 0 0;font-weight:600">Landing page</p>
            </div>
            <div class="card-paw pad">
                <img src="/recursos/Img/dashboard-usuario.png" alt="Dashboard" style="height:220px;object-fit:cover;object-position:top" />
                <p class="muted" style="margin:.6rem 0 0;font-weight:600">Dashboards y registros</p>
            </div>
            <div class="card-paw pad">
                <img src="/recursos/Img/explorar-clinicas.png" alt="Citas" style="height:220px;object-fit:cover;object-position:top" />
                <p class="muted" style="margin:.6rem 0 0;font-weight:600">Clínicas, citas y mascotas</p>
            </div>
        </div>
    </div>
</section>