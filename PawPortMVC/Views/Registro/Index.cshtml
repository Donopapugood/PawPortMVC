@{
    ViewData["Title"] = "Portafolio";
}
<section class="banner">
    <div class="container">
        <h1>Nuestro portafolio de diseño</h1>
        <p>Prototipo interactivo y sistema de diseño de PawPort creado en Figma por el equipo A2D2.</p>
    </div>
</section>
<section class="section">
    <div class="container" style="text-align:center">
        <h2>Prototipo oficial en Figma</h2>
        <p class="sub">Explora todas las pantallas diseñadas: landing, login, registros, dashboards, expedientes, inventario, reportes y clínicas.</p>
        <a href="https://www.figma.com/design/AZY7ISSEsifnJim3oF81tS/A2D2--Copy-?t=QybP9cV9oR6l8JUq-1" target="_blank" class="btn-paw btn-big">Ver prototipo en Figma</a>
    </div>
    <div class="container galeria" style="margin-top:2.5rem">
        <div class="grid">
            <div><img src="/recursos/Img/pawport-landing-page.png" alt="Landing" /><p class="muted">Landing page</p></div>
            <div><img src="/recursos/Img/dashboard-usuario.png" alt="Dashboard Usuario" /><p class="muted">Panel del Propietario</p></div>
            <div><img src="/recursos/Img/pacientes-expedientes.png" alt="Expedientes" /><p class="muted">Gestión de Pacientes y Expedientes</p></div>
            <div><img src="/recursos/Img/inventario-clinica.png" alt="Inventario" /><p class="muted">Inventario de Medicamentos</p></div>
            <div><img src="/recursos/Img/reportes-clinica.png" alt="Reportes" /><p class="muted">Reportes y Estadísticas</p></div>
            <div><img src="/recursos/Img/configuracion-clinica.png" alt="Configuración" /><p class="muted">Configuración de Sucursal y Equipo</p></div>
        </div>
    </div>
</section>